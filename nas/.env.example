# NAS observability stack — runtime environment. Copy to .env and fill in.
#
#   cp .env.example .env

# Tailscale auth key for the observability sidecar. Generate a REUSABLE key
# (not your personal login) at https://login.tailscale.com/admin/settings/keys
# — tag it (e.g. tag:observability) if your tailnet uses ACL tags. Either
# disable its expiry or set a calendar reminder to rotate it: an expired key
# means this container silently can't rejoin the tailnet after any restart,
# which is exactly the kind of failure this whole stack exists to catch —
# don't let it happen to the stack itself.
TS_AUTHKEY=

# Grafana's admin password. Only takes effect on first boot (a fresh
# ./grafana-data volume) — changing this later and restarting does nothing;
# use Grafana's own admin UI or CLI to change an existing admin password.
GRAFANA_ADMIN_PASSWORD=
