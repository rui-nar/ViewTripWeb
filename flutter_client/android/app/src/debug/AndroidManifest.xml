<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.

         It is also declared in the main manifest, because the app itself needs
         it in every build type — see the comment there.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug-only: permit cleartext to the local dev server (run-android.ps1
         -Local). Release builds inherit Android's default, which forbids it. -->
    <application android:networkSecurityConfig="@xml/network_security_config"/>
</manifest>
